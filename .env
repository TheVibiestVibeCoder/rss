# RSS Feed Manager Configuration
# Fill in your details below

# Your admin password (required!)
ADMIN_PASSWORD=changeme123

# Email where you want to receive alerts
EMAIL_TO=your@email.com

# Email address alerts are sent from
EMAIL_FROM=alerts@yourdomain.com

# Secret key for cron access (change this to something random)
CRON_KEY=change_this_to_random_string

# Timezone (e.g., Europe/Vienna, America/New_York, UTC)
TIMEZONE=Europe/Vienna
